# Copy this file to .env.local and fill in the Basic Auth credentials from the
# Coalition Technologies Patient Data API documentation (Postman).
#
# These are SERVER-SIDE variables: only the API proxy (api/patients.js, served
# by Vercel or the local Vite server) reads them. They are never bundled into
# the browser code. Do not rename them with a VITE_ prefix.
COALITION_API_USERNAME=
COALITION_API_PASSWORD=

# Optional: override the upstream API URL (defaults to the documented endpoint).
# COALITION_API_URL=https://fedskillstest.coalitiontechnologies.workers.dev
